# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used for SEO metadata (canonical/OG URLs, sitemap.xml,
# robots.txt). Defaults to http://localhost:3000 if unset. Set to the real
# production domain once one is confirmed.
NEXT_PUBLIC_SITE_URL=

# Supabase — server-only. NEVER prefix with NEXT_PUBLIC_, never commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (AUTH-002). Consumed by supabase/config.toml, not by the
# Next.js app directly. Without real values, email/password auth still
# works — only the "Continue with Google" button fails at click-time.
# See a Google Cloud Console OAuth 2.0 Client ID (Web application), with
# http://127.0.0.1:54321/auth/v1/callback as an authorized redirect URI
# for local dev.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# SMTP credentials shared by supabase/config.toml's [auth.email.smtp] block
# (Supabase Auth's own emails) AND src/lib/email.ts (app-triggered emails,
# e.g. vehicle inquiry notifications) — the same transport, not two
# separate ones. In local dev, set these to a Mailtrap sandbox inbox (never
# delivers to real addresses — from Mailtrap → Email Testing → your inbox →
# SMTP Settings). In production (Vercel), set these to the real SMTP
# provider's credentials instead — never commit real values here.
SMTP_USER=
SMTP_PASS=

# Host/port for the same SMTP transport — default to Mailtrap's sandbox
# host/port (sandbox.smtp.mailtrap.io:2525) when unset; set to a real
# provider's host/port in production (e.g. smtp.gmail.com:587).
SMTP_HOST=
SMTP_PORT=

# The "From" address app-triggered emails are sent as (src/lib/email.ts) —
# must match (or be a verified alias of) SMTP_USER for most real providers,
# or the message gets rewritten/bounced/flagged as spam. Defaults to a
# placeholder .local address that only "works" against Mailtrap's sandbox,
# which never actually validates it.
SMTP_FROM_EMAIL=

# Authenticates scheduled calls to /api/cron/subscription-reminders (see
# vercel.json's `crons` entry — Vercel sends this same value as
# `Authorization: Bearer <value>`). Without it set, that route refuses every
# request rather than falling open. Not needed for the manual "Send
# reminders now" admin button, which goes through normal admin auth instead.
CRON_SECRET=

# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit actual secrets.
